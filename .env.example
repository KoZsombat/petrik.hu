# Copy this file to .env before a local `docker compose up --build`.
# On Launchpad these two are entered in the app's environment form instead -
# see LAUNCHPAD.md.

# Required. Signs the login cookies. Generate one with:  openssl rand -hex 32
# The public dev default in apps/server/config.ts is refused in production.
PNW_SESSION_SECRET=

# Required. Password of the three accounts seeded into an EMPTY database
# (mk.vezeto, helyettes, igazgato - the last two can manage accounts, pages and
# the document library); without it a production start is refused. Min. 8
# characters. It has no effect once the database has accounts. A local
# `npm run server` does not need it: it keeps the public demo passwords on
# purpose.
PNW_SEED_PASSWORD=

# Required by docker-compose.yml: the `tunnel` service runs cloudflared with
# this token, so `docker compose up` stops at parse time without it. Copy it
# from the tunnel's install command (Zero Trust → Networks → Tunnels →
# install / `docker run cloudflare/cloudflared ... --token ...`). The public
# hostname is configured on the same page and must point at http://client:80.
CLOUDFLARE_TUNNEL_TOKEN=

# Print the demo accounts on the login card. Never true on a public site.
PNW_SHOW_DEMO_LOGINS=false

# Host port for the client container locally (default 4000).
# PNW_PORT=4000
