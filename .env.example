# Copy this file to .env and fill it in before running docker compose
# beyond your own machine (see server/config.ts and DEPLOY.md).

# Signs the login cookies. Generate one with:  openssl rand -hex 32
PNW_SESSION_SECRET=change-me-to-a-long-random-string

# Password of the three seeded accounts (mk.vezeto, helyettes, igazgato) -
# used only when the database is empty, i.e. on a fresh server. Min. 8 chars.
# Leave empty to keep the public demo passwords (local use only!).
PNW_SEED_PASSWORD=

# Print the demo accounts on the login card. Never true on a public site.
PNW_SHOW_DEMO_LOGINS=false

# Cloudflare tunnel (DEPLOY.md step 5): the token from Zero Trust ->
# Networks -> Tunnels, and the profile that switches the tunnel service on.
CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel

# PNW_PORT=4000
