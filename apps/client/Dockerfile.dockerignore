# BuildKit reads <Dockerfile>.dockerignore instead of the root .dockerignore.
# public/media is excluded below on purpose: the mirrored media lives in the
# server's database (AGENT.md 6.25), so vite only needs the code.
**/node_modules
**/dist
apps/server
!apps/server/package.json
.git
.env
*.log
# The mirrored media lives in the server's database (AGENT.md 6.25), not in the image.
apps/client/public/media
